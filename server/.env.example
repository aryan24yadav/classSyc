# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/classsync

# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:3000

# ZEGOCLOUD (Admin Console -> your project). The server secret stays on the server only.
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# How long a video token is valid, in seconds (default 7200 = 2 hours)
ZEGO_TOKEN_TTL_SECONDS=7200
